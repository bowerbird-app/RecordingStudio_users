<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header { render FlatPack::PageTitle::Component.new(title: "Choose a new password", variant: :h2) } %>
  <% card.body do %>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do %>
      <%= hidden_field_tag "#{resource_name}[reset_password_token]", resource.reset_password_token %>
      <div class="space-y-4">
        <%= render FlatPack::PasswordInput::Component.new(
          name: "#{resource_name}[password]",
          label: "New password",
          required: true
        ) %>
        <%= render FlatPack::PasswordInput::Component.new(
          name: "#{resource_name}[password_confirmation]",
          label: "Confirm new password",
          required: true
        ) %>
        <%= render FlatPack::Button::Component.new(text: "Update password", style: :primary, type: "submit") %>
      </div>
    <% end %>
  <% end %>
<% end %>
