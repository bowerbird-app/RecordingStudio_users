<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header { render FlatPack::PageTitle::Component.new(title: "Reset password", variant: :h2) } %>
  <% card.body do %>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do %>
      <div class="space-y-4">
        <%= render FlatPack::EmailInput::Component.new(
          name: "#{resource_name}[email]",
          label: "Email",
          value: resource.email,
          required: true
        ) %>
        <%= render FlatPack::Button::Component.new(text: "Send reset instructions", style: :primary, type: "submit") %>
      </div>
    <% end %>
  <% end %>
<% end %>
