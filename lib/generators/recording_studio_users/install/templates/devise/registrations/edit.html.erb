<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header { render FlatPack::PageTitle::Component.new(title: "Account security", variant: :h2) } %>
  <% card.body do %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do %>
      <div class="space-y-4">
        <%= render FlatPack::EmailInput::Component.new(
          name: "#{resource_name}[email]",
          label: "Email",
          value: resource.email,
          required: true
        ) %>
        <%= render FlatPack::PasswordInput::Component.new(
          name: "#{resource_name}[password]",
          label: "New password"
        ) %>
        <%= render FlatPack::PasswordInput::Component.new(
          name: "#{resource_name}[password_confirmation]",
          label: "Confirm new password"
        ) %>
        <%= render FlatPack::PasswordInput::Component.new(
          name: "#{resource_name}[current_password]",
          label: "Current password",
          required: true
        ) %>
        <%= render FlatPack::Button::Component.new(text: "Update account", style: :primary, type: "submit") %>
      </div>
    <% end %>
  <% end %>
<% end %>
