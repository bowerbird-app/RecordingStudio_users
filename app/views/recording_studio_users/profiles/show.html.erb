<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(
    back_tooltip: "Back to previous page",
    anchor_url: main_app.root_path,
    anchor_icon: "home",
    anchor_tooltip: "Home"
  ) do |component| %>
    <% component.right_slot do %>
      <%= render FlatPack::Tooltip::Component.new(text: "Edit profile") do %>
        <%= render FlatPack::Button::Component.new(
          icon: "pencil",
          icon_only: true,
          style: :secondary,
          size: :md,
          url: edit_profile_path,
          aria: {label: "Edit profile"}
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <div class="border-b border-(--surface-border-color) pb-6">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Your profile",
      subtitle: "Manage the identity information shared by supported Recording Studio features.",
      variant: :h2
    ) %>
  </div>

  <div class="space-y-6">
    <%= recording_studio_user_identity(current_recording_studio_user, show_email: true) %>

    <dl class="grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <dt class="text-sm font-medium">Biography</dt>
        <dd class="mt-1 text-sm leading-6"><%= @profile.biography.presence || "Not provided" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium">Locale</dt>
        <dd class="mt-1 text-sm"><%= @profile.locale.presence || "Default" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium">Time zone</dt>
        <dd class="mt-1 text-sm"><%= @profile.time_zone.presence || "Default" %></dd>
      </div>
    </dl>
  </div>
</div>
