<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(
    back_tooltip: "Back to previous page",
    anchor_url: main_app.root_path,
    anchor_icon: "home",
    anchor_tooltip: "Home"
  ) %>

  <div class="border-b border-(--surface-border-color) pb-6">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Edit profile",
      subtitle: "Profile changes create a new Recording Studio revision.",
      variant: :h2
    ) %>
  </div>

  <section class="space-y-5 border-b border-(--surface-border-color) pb-8" aria-labelledby="avatar-heading">
    <div>
      <h3 id="avatar-heading" class="text-lg font-semibold">Avatar</h3>
      <p class="mt-1 text-sm text-(--surface-muted-content-color)">Choose the image shown with your identity.</p>
    </div>

    <%= recording_studio_user_avatar(current_recording_studio_user, size: :large) %>

    <%= form_with(
      url: avatar_profile_path,
      method: @avatar_recording ? :patch : :post,
      data: {
        controller: "recording-studio-attachable--attachment-revision-upload",
        action: "change->recording-studio-attachable--attachment-revision-upload#fileSelected " \
          "drop->recording-studio-attachable--attachment-revision-upload#fileSelected " \
          "submit->recording-studio-attachable--attachment-revision-upload#handleSubmit",
        recording_studio_attachable__attachment_revision_upload_direct_upload_url_value:
          main_app.rails_direct_uploads_path,
        recording_studio_attachable__attachment_revision_upload_max_file_size_value:
          RecordingStudioUsers.configuration.avatar_max_byte_size
      }
    ) do %>
      <div class="space-y-4">
        <%= render FlatPack::FileInput::Component.new(
          name: "avatar_file",
          label: @avatar_recording ? "Replace avatar" : "Upload avatar",
          accept: RecordingStudioUsers.configuration.avatar_content_types.join(","),
          max_size: RecordingStudioUsers.configuration.avatar_max_byte_size,
          required: true,
          data: {
            recording_studio_attachable__attachment_revision_upload_target: "fileInput"
          }
        ) %>
        <%= hidden_field_tag :signed_blob_id, nil,
          data: {recording_studio_attachable__attachment_revision_upload_target: "signedBlobInput"} %>
        <p class="hidden text-sm text-(--surface-muted-content-color)"
           data-recording-studio-attachable--attachment-revision-upload-target="status"></p>
        <%= render FlatPack::Button::Component.new(
          text: @avatar_recording ? "Replace avatar" : "Upload avatar",
          style: :primary,
          type: "submit",
          data: {recording_studio_attachable__attachment_revision_upload_target: "submitButton"}
        ) %>
      </div>
    <% end %>

    <% if @avatar_recording %>
      <%= form_with url: avatar_profile_path, method: :delete do %>
        <%= render FlatPack::Button::Component.new(
          text: "Remove avatar",
          style: :secondary,
          type: "submit"
        ) %>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-5" aria-labelledby="profile-fields-heading">
    <h3 id="profile-fields-heading" class="text-lg font-semibold">Profile information</h3>

    <%= form_with(
      scope: :profile,
      url: profile_path,
      method: :patch,
      data: {
        controller: "recording-studio-users--profile-preferences",
        recording_studio_users__profile_preferences_default_locale_value:
          I18n.default_locale.to_s.tr("_", "-")
      }
    ) do %>
      <div class="space-y-4">
        <% if RecordingStudioUsers.configuration.profile_fields.include?(:display_name) %>
          <%= render FlatPack::TextInput::Component.new(
            name: "profile[display_name]",
            label: "Display name",
            value: @profile.display_name
          ) %>
        <% end %>

        <% if RecordingStudioUsers.configuration.profile_fields.include?(:biography) %>
          <%= render FlatPack::TextArea::Component.new(
            name: "profile[biography]",
            label: "Biography",
            value: @profile.biography
          ) %>
        <% end %>

        <% if RecordingStudioUsers.configuration.profile_fields.include?(:locale) %>
          <div data-recording-studio-users--profile-preferences-target="locale">
            <%= render FlatPack::Select::Component.new(
              name: "profile[locale]",
              label: "Locale",
              placeholder: "Select a locale",
              options: RecordingStudioUsers::ProfilePreferences.with_legacy_value(
                RecordingStudioUsers::ProfilePreferences.locale_options,
                @profile.locale
              ),
              value: @profile.locale,
              searchable: true,
              search_mode: :local
            ) %>
          </div>
        <% end %>

        <% if RecordingStudioUsers.configuration.profile_fields.include?(:time_zone) %>
          <div data-recording-studio-users--profile-preferences-target="timeZone">
            <%= render FlatPack::Select::Component.new(
              name: "profile[time_zone]",
              label: "Time zone",
              placeholder: "Select a time zone",
              options: RecordingStudioUsers::ProfilePreferences.with_legacy_value(
                RecordingStudioUsers::ProfilePreferences.time_zone_options,
                @profile.time_zone
              ),
              value: @profile.time_zone,
              searchable: true,
              search_mode: :local
            ) %>
          </div>
        <% end %>

        <div class="flex gap-2">
          <%= render FlatPack::Button::Component.new(
            text: "Save profile",
            style: :primary,
            type: "submit"
          ) %>
          <%= render FlatPack::Button::Component.new(
            text: "Cancel",
            style: :secondary,
            url: profile_path
          ) %>
        </div>
      </div>
    <% end %>
  </section>
</div>
