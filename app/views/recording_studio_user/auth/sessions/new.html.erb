<div class="flex min-h-dvh items-center justify-center">
  <div class="w-full max-w-sm space-y-6">
    <%= render FlatPack::PageTitle::Component.new(
      title: RecordingStudioUser.config.login_title,
      variant: :h2,
      class: "mb-0 pb-0 text-center"
    ) %>

    <% if flash[:alert].present? %>
      <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
    <% end %>

    <%= form_with scope: :user, url: (respond_to?(:user_session_path) ? user_session_path : recording_studio_users.sign_in_password_path), method: :post do %>
      <div class="space-y-4">
        <%= render FlatPack::EmailInput::Component.new(
          name: "user[email]",
          label: "Email",
          required: true,
          autocomplete: "email"
        ) %>

        <%= render FlatPack::PasswordInput::Component.new(
          name: "user[password]",
          label: "Password",
          required: true,
          autocomplete: "current-password"
        ) %>

        <%= render FlatPack::Button::Component.new(
          text: "Sign in",
          style: :primary,
          size: :md,
          type: "submit",
          class: "w-full"
        ) %>
      </div>
    <% end %>

    <p class="text-center text-sm text-[var(--surface-muted-content-color)]">
      Don't have an account?
      <%= render FlatPack::Link::Component.new(href: (respond_to?(:new_user_registration_path) ? new_user_registration_path : recording_studio_users.sign_up_path)) do %>
        Sign up
      <% end %>
    </p>

    <%= render "recording_studio_user/omniauth/continue_with_providers" %>
  </div>
</div>
