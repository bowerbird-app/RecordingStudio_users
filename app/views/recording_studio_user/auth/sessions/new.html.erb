<%= render layout: "recording_studio_user/auth/shell", locals: { title: RecordingStudioUser.config.login_title } do %>
  <% if flash[:alert].present? %>
    <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
  <% end %>

  <%= form_with scope: :user, url: password_session_path, method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::EmailInput::Component.new(
        name: "user[email]",
        label: "Email",
        required: true,
        autocomplete: "email"
      ) %>

      <%= render FlatPack::PasswordInput::Component.new(
        name: "user[password]",
        label: "Password",
        required: true,
        autocomplete: "current-password"
      ) %>

      <%= render FlatPack::Button::Component.new(
        text: "Sign in",
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>

  <p class="text-center text-sm text-[var(--surface-muted-content-color)]">
    Don't have an account?
    <%= render FlatPack::Link::Component.new(href: auth_sign_up_path) do %>
      Sign up
    <% end %>
  </p>

  <%= render "recording_studio_user/omniauth/continue_with_providers" %>
<% end %>
