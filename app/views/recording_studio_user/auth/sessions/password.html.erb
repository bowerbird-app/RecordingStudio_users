<%= render layout: "recording_studio_user/auth/shell", locals: { title: RecordingStudioUser.config.login_title } do %>
  <% if flash[:alert].present? %>
    <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
  <% end %>

  <%= form_with scope: :user, url: password_session_path, method: :post do %>
    <div class="space-y-4">
      <input type="hidden" name="user[email]" value="<%= @email %>" autocomplete="username">

      <%= render FlatPack::PasswordInput::Component.new(
        name: "user[password]",
        label: "Password",
        required: true,
        autocomplete: "current-password"
      ) %>

      <%= render FlatPack::Button::Component.new(
        text: "Sign in",
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>
<% end %>
