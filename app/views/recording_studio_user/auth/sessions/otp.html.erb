<%= render layout: "recording_studio_user/auth/shell", locals: {
  title: "Email sign-in code",
  subtitle: "We will email a code if your account is eligible."
} do %>
  <%= form_with scope: :user, url: otp_session_otp_path, method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::EmailInput::Component.new(name: "user[email]", label: "Email", required: true, autocomplete: "email") %>
      <%= render FlatPack::Button::Component.new(text: "Send code", style: :primary, size: :md, type: "submit", class: "w-full") %>
    </div>
  <% end %>
<% end %>
