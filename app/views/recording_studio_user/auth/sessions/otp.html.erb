<%= render layout: "recording_studio_user/auth/shell", locals: {
  title: rsu_t("sessions.email_sign_in_code", default: "Email sign-in code"),
  subtitle: rsu_t("sessions.email_sign_in_code_subtitle", default: "We will email a code if your account is eligible.")
} do %>
  <%= form_with scope: :user, url: otp_session_otp_path, method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::EmailInput::Component.new(
        name: "user[email]",
        placeholder: rsu_t("auth.email_placeholder", default: "you@company.com"),
        required: true,
        autocomplete: "email",
        aria: { label: rsu_t("auth.email", default: "Email") }
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: rsu_t("sessions.send_code", default: "Send code"),
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>
<% end %>
