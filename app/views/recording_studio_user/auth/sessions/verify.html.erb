<%= render layout: "recording_studio_user/auth/shell", locals: { title: t("recording_studio_user.sessions.enter_code") } do %>
  <% if flash[:notice].present? %>
    <%= render FlatPack::Alert::Component.new(title: flash[:notice], style: :info) %>
  <% end %>
  <% if flash[:alert].present? %>
    <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
  <% end %>
  <%= form_with url: otp_session_verify_path, method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::TextInput::Component.new(
        name: "code",
        label: t("recording_studio_user.sessions.sign_in_code"),
        required: true,
        inputmode: "numeric",
        autocomplete: "one-time-code",
        maxlength: 6
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio_user.auth.sign_in"),
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>
  <%= form_with url: otp_session_resend_path, method: :post do %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio_user.sessions.resend_code"),
      style: :secondary,
      size: :md,
      type: "submit",
      class: "w-full"
    ) %>
  <% end %>
<% end %>
