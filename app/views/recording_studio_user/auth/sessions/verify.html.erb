<div class="flex min-h-dvh items-center justify-center">
  <div class="w-full max-w-sm space-y-6">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Enter your code",
      variant: :h2,
      class: "mb-0 pb-0 text-center"
    ) %>
    <% if flash[:notice].present? %>
      <%= render FlatPack::Alert::Component.new(title: flash[:notice], style: :info) %>
    <% end %>
    <% if flash[:alert].present? %>
      <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
    <% end %>
    <%= form_with url: otp_session_verify_path, method: :post do %>
      <div class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(name: "code", label: "Sign-in code", required: true, inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6) %>
        <%= render FlatPack::Button::Component.new(text: "Sign in", style: :primary, size: :md, type: "submit", class: "w-full") %>
      </div>
    <% end %>
    <%= form_with url: otp_session_resend_path, method: :post do %>
      <%= render FlatPack::Button::Component.new(text: "Resend code", style: :secondary, size: :md, type: "submit", class: "w-full") %>
    <% end %>
  </div>
</div>
