<%= render layout: "recording_studio_user/auth/shell", locals: {
  title: rsu_t("registrations.check_email", default: "Check your email"),
  subtitle: rsu_t("registrations.check_email_subtitle", default: "Enter the six-digit code we sent you.")
} do %>
  <% if flash[:alert].present? %>
    <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
  <% end %>

  <%= form_with url: otp_registration_verify_path, method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::TextInput::Component.new(
        name: "code",
        id: "code",
        label: rsu_t("registrations.verification_code", default: "Verification code"),
        required: true,
        inputmode: "numeric",
        autocomplete: "one-time-code",
        maxlength: 6
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: rsu_t("registrations.verify_and_continue", default: "Verify and continue"),
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>

  <%= form_with url: otp_registration_resend_path, method: :post do %>
    <%= render FlatPack::Button::Component.new(
      text: rsu_t("registrations.resend_code", default: "Resend code"),
      style: :secondary,
      size: :md,
      type: "submit",
      class: "w-full"
    ) %>
  <% end %>
<% end %>
