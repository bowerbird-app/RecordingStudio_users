<div class="flex min-h-dvh items-center justify-center">
  <div class="w-full max-w-sm space-y-6">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Check your email",
      variant: :h2,
      class: "mb-0 pb-0 text-center"
    ) %>
    <p class="text-center text-sm text-[var(--surface-muted-content-color)]">
      Enter the six-digit code we sent you.
    </p>

    <% if flash[:alert].present? %>
      <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
    <% end %>

    <%= form_with url: otp_registration_verify_path, method: :post do %>
      <div class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(name: "code", id: "code", label: "Verification code", required: true, inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6) %>
        <%= render FlatPack::Button::Component.new(text: "Verify and continue", style: :primary, size: :md, type: "submit", class: "w-full") %>
      </div>
    <% end %>

    <%= form_with url: otp_registration_resend_path, method: :post do %>
      <%= render FlatPack::Button::Component.new(text: "Resend code", style: :secondary, size: :md, type: "submit", class: "w-full") %>
    <% end %>
  </div>
</div>
