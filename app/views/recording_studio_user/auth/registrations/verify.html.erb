<div class="space-y-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Check your email", variant: :h2) %>
  <p class="text-muted">Enter the six-digit code we sent you.</p>

  <% if flash[:alert].present? %>
    <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
  <% end %>

  <%= form_with url: otp_registration_verify_path, method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::TextInput::Component.new(name: "code", id: "code", label: "Verification code", required: true, inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6) %>
      <%= render FlatPack::Button::Component.new(text: "Verify and continue", style: :primary, type: "submit") %>
    </div>
  <% end %>

  <%= form_with url: otp_registration_resend_path, method: :post do %>
    <%= render FlatPack::Button::Component.new(text: "Resend code", style: :secondary, type: "submit") %>
  <% end %>
</div>
