<% heading = RecordingStudioUser.config.sign_up_heading(params[:variant]) %>
<%= render layout: "recording_studio_user/auth/shell",
           locals: { title: heading[:title], subtitle: heading[:subtitle] } do %>
  <%= form_with scope: :user,
                url: RecordingStudioUser::ReturnTo.with_query(auth_sign_up_path, variant: params[:variant]),
                method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::EmailInput::Component.new(
        name: "user[email]",
        id: "user_email",
        value: @resource&.email,
        placeholder: t("recording_studio_user.auth.email_placeholder"),
        required: true,
        autocomplete: "email",
        aria: { label: t("recording_studio_user.auth.email") },
        error: @resource&.errors&.[](:email)&.first
      ) %>

      <%= render partial: "recording_studio_user/auth/signup_notices" %>

      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio_user.auth.continue_with_email"),
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>

  <%= render FlatPack::Content::Component.new(class: "text-center") do %>
    <%= t("recording_studio_user.auth.already_have_one") %>
    <%= render FlatPack::Link::Component.new(
      href: recording_studio_user_sign_in_path(return_to: auth_carried_return_to, popup: auth_carried_popup?)
    ) do %>
      <%= t("recording_studio_user.auth.log_in") %>
    <% end %>
  <% end %>

  <%= render "recording_studio_user/omniauth/continue_with_providers" %>
<% end %>
