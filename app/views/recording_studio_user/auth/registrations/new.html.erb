<div class="space-y-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Create your account", variant: :h2) %>
  <p class="text-muted">Pick how you want to sign in later.</p>

  <div class="flex flex-col gap-3">
    <%= render FlatPack::Button::Component.new(text: "Continue with password", style: :secondary, href: otp_registration_password_path) %>
    <%= render FlatPack::Button::Component.new(text: "Continue with email OTP", style: :primary, href: otp_registration_otp_path) %>
  </div>

  <%= render FlatPack::Link::Component.new(href: (respond_to?(:new_user_session_path) ? new_user_session_path : recording_studio_users.sign_in_path)) do %>
    Already have an account? Sign in
  <% end %>

  <%= render "recording_studio_user/omniauth/continue_with_providers" %>
</div>
