<%= render layout: "recording_studio_user/auth/shell", locals: {
  title: t("recording_studio_user.registrations.sign_up_with_email"),
  subtitle: t("recording_studio_user.registrations.sign_up_with_email_subtitle")
} do %>
  <%= form_with scope: :user, url: otp_registration_otp_path, method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::EmailInput::Component.new(
        name: "user[email]",
        id: "user_email",
        placeholder: t("recording_studio_user.auth.email_placeholder"),
        required: true,
        autocomplete: "email",
        aria: { label: t("recording_studio_user.auth.email") }
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio_user.registrations.send_code"),
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>
<% end %>
