<div class="space-y-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Sign up with password", variant: :h2) %>

  <%= form_with scope: :user, url: (respond_to?(:user_registration_path) ? user_registration_path : recording_studio_users.sign_up_password_path), method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::EmailInput::Component.new(name: "user[email]", id: "user_email", label: "Email", required: true, autocomplete: "email") %>
      <%= render FlatPack::PasswordInput::Component.new(name: "user[password]", id: "user_password", label: "Password", required: true, autocomplete: "new-password") %>
      <% if RecordingStudioUser.config.require_password_confirmation? %>
        <%= render FlatPack::PasswordInput::Component.new(name: "user[password_confirmation]", id: "user_password_confirmation", label: "Confirm password", required: true, autocomplete: "new-password") %>
      <% end %>
      <%= render FlatPack::Button::Component.new(text: "Sign up", style: :primary, type: "submit") %>
    </div>
  <% end %>
</div>
