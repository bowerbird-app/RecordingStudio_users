<%= render layout: "recording_studio_user/auth/shell", locals: { title: "Sign up" } do %>
  <% if flash[:alert].present? %>
    <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :danger) %>
  <% end %>

  <%= form_with scope: :user, url: password_registration_path, method: :post do %>
    <div class="space-y-4">
      <% if @resource.errors.any? %>
        <%= render FlatPack::Alert::Component.new(
          title: "That sign up did not save",
          description: @resource.errors.full_messages.join(", "),
          style: :danger
        ) %>
      <% end %>

      <input type="hidden" name="user[email]" id="user_email" value="<%= @resource.email %>" autocomplete="username">

      <%= render FlatPack::PasswordInput::Component.new(
        name: "user[password]",
        id: "user_password",
        label: "Password",
        required: true,
        autocomplete: "new-password",
        help_text: "#{Devise.password_length.min} characters minimum",
        error: @resource.errors[:password].first
      ) %>

      <% if RecordingStudioUser.config.require_password_confirmation? %>
        <%= render FlatPack::PasswordInput::Component.new(
          name: "user[password_confirmation]",
          id: "user_password_confirmation",
          label: "Password confirmation",
          required: true,
          autocomplete: "new-password",
          error: @resource.errors[:password_confirmation].first
        ) %>
      <% end %>

      <%= render FlatPack::Button::Component.new(
        text: "Sign up",
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>
<% end %>
