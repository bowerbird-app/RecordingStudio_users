<%= render layout: "recording_studio_user/auth/shell",
           locals: {
             title: rsu_t("auth.resend_confirmation"),
             subtitle: rsu_t("auth.resend_confirmation_subtitle")
           } do %>
  <% if resource.errors.any? %>
    <%= render FlatPack::Alert::Component.new(
      title: rsu_t("auth.could_not_send_link"),
      description: resource.errors.full_messages.join(", "),
      style: :danger
    ) %>
  <% end %>

  <%= form_with scope: resource_name, url: confirmation_path(resource_name), method: :post do %>
    <div class="space-y-4">
      <%= render FlatPack::EmailInput::Component.new(
        name: "#{resource_name}[email]",
        id: "#{resource_name}_email",
        value: resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email,
        placeholder: rsu_t("auth.email_placeholder"),
        required: true,
        autocomplete: "email",
        aria: { label: rsu_t("auth.email") },
        error: resource.errors[:email].first
      ) %>

      <%= render FlatPack::Button::Component.new(
        text: rsu_t("auth.resend_confirmation"),
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    </div>
  <% end %>

  <p class="text-center text-sm text-[var(--surface-muted-content-color)]">
    <%= render FlatPack::Link::Component.new(href: auth_sign_in_path) do %>
      <%= rsu_t("auth.back_to_sign_in") %>
    <% end %>
  </p>
<% end %>
