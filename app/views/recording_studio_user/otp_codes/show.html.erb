<% content_for :title, t("recording_studio_user.otp.your_sign_in_code") %>
<% content_for :subtitle, t("recording_studio_user.otp.use_this_code") if @code.present? %>

<% flat_pack_page_nav(
  round: true,
  style: :default,
  anchor_href: main_app.root_path,
  anchor_tooltip: t("recording_studio_user.profile.close")
) %>

<% if @code.present? %>
  <p class="select-all font-mono text-5xl font-semibold tracking-[0.25em] text-(--surface-content-color)">
    <%= @code %>
  </p>
  <p class="mt-2 text-sm text-(--surface-muted-content-color)">
    <%= t("recording_studio_user.otp.expires_in", time: time_ago_in_words(@challenge.expires_at)) %>
  </p>
<% else %>
  <%= render FlatPack::Alert::Component.new(
    title: t("recording_studio_user.otp.no_longer_valid"),
    description: t("recording_studio_user.otp.request_fresh"),
    style: :info
  ) %>
<% end %>
