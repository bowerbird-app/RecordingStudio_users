<% content_for :title, t(
  "recording_studio_user.profile.document_title",
  page: t("recording_studio_user.otp.your_sign_in_code")
) %>

<% recording_studio_page_nav(
  title: t("recording_studio_user.otp.your_sign_in_code"),
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: t("recording_studio_user.profile.close")
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: t("recording_studio_user.otp.your_sign_in_code"),
  subtitle: (@code.present? ? t("recording_studio_user.otp.use_this_code") : nil),
  variant: :h1
) %>

<% if @code.present? %>
  <p class="select-all font-mono text-5xl font-semibold tracking-[0.25em] text-(--surface-content-color)">
    <%= @code %>
  </p>
  <p class="mt-2 text-sm text-(--surface-muted-content-color)">
    <%= t("recording_studio_user.otp.expires_in", time: time_ago_in_words(@challenge.expires_at)) %>
  </p>
<% else %>
  <%= render FlatPack::Alert::Component.new(
    title: t("recording_studio_user.otp.no_longer_valid"),
    description: t("recording_studio_user.otp.request_fresh"),
    style: :info
  ) %>
<% end %>
