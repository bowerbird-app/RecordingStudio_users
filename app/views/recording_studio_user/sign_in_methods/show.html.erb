<% content_for :title, "Sign-in methods | Recording Studio User" %>

<% recording_studio_page_nav(
  title: "Sign-in methods",
  page_nav_back_url: profile_path,
  page_nav_back_label: "My Profile",
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: "Close"
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Sign-in methods",
  subtitle: profile_display_name(@user),
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <div>
    <% connectable_providers = recording_studio_user_omniauth_provider_names.reject { |provider|
         recording_studio_user_provider_connected?(@user, provider)
       } %>
    <% if @identities.any? || connectable_providers.any? %>
      <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
        <% card.body do %>
          <%= render FlatPack::List::Component.new(divider: true) do %>
            <% @identities.each do |identity| %>
              <%= render FlatPack::List::Item.new(
                **recording_studio_user_provider_list_item_leading(identity.provider),
                # Flatpack List::Item defaults to items-start; force middle align for logo + actions.
                class: "!items-center",
                trailing: capture {
                  form_with(
                    url: profile_identity_path(identity.provider),
                    method: :delete,
                    class: "inline-flex items-center",
                    data: {
                      turbo_confirm: "Disconnect #{recording_studio_user_provider_label(identity.provider)}?"
                    }
                  ) do
                    render FlatPack::Button::Component.new(
                      text: "Disconnect",
                      type: "submit",
                      style: :secondary,
                      size: :sm
                    )
                  end
                }
              ) do %>
                <p class="font-medium"><%= recording_studio_user_provider_label(identity.provider) %></p>
                <% if identity.email.present? %>
                  <p class="text-sm text-[var(--surface-muted-content-color)]"><%= identity.email %></p>
                <% end %>
              <% end %>
            <% end %>

            <% connectable_providers.each do |provider| %>
              <% authorize_path = recording_studio_user_omniauth_authorize_path(provider) %>
              <% next if authorize_path.blank? %>
              <%= render FlatPack::List::Item.new(
                **recording_studio_user_provider_list_item_leading(provider),
                class: "!items-center",
                trailing: capture {
                  form_with(
                    url: authorize_path,
                    method: :post,
                    class: "inline-flex items-center",
                    data: { turbo: false }
                  ) do
                    render FlatPack::Button::Component.new(
                      text: "Connect",
                      type: "submit",
                      style: :secondary,
                      size: :sm
                    )
                  end
                }
              ) do %>
                <p class="font-medium"><%= recording_studio_user_provider_label(provider) %></p>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
