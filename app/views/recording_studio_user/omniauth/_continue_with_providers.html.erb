<%# Flatpack Or divider + Continue-with buttons for every configured OmniAuth provider. %>
<% if recording_studio_user_omniauth_configured? %>
  <%= render FlatPack::Divider::Component.new(label: "Or", class: "my-4") %>

  <div class="flex flex-col gap-2">
    <% recording_studio_user_omniauth_provider_names.each do |provider| %>
      <% authorize_path = recording_studio_user_omniauth_authorize_path(provider) %>
      <% next if authorize_path.blank? %>
      <% logo = recording_studio_user_provider_logo(provider) %>
      <% button_icon = logo.to_s.start_with?("<svg") ? logo : nil %>
      <%= render FlatPack::Button::Component.new(
        text: "Continue with #{recording_studio_user_provider_label(provider)}",
        icon: button_icon,
        href: authorize_path,
        method: :post,
        style: :secondary,
        size: :md,
        class: "w-full",
        data: { turbo: false }
      ) %>
    <% end %>
  </div>
<% end %>
