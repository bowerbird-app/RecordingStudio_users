<% content_for :title, t(
  "recording_studio_user.profile.document_title",
  page: t("recording_studio_user.profile.edit_profile")
) %>

<% recording_studio_page_nav(
  title: t("recording_studio_user.profile.edit_profile"),
  page_nav_back_url: profile_path,
  page_nav_back_label: t("recording_studio_user.profile.my_profile"),
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: t("recording_studio_user.profile.close")
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: t("recording_studio_user.profile.edit_profile"),
  subtitle: (
    profile_locale_allowlisted? ?
      t("recording_studio_user.profile.subtitle_with_language") :
      t("recording_studio_user.profile.subtitle")
  ),
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <div>
    <div class="mb-8">
      <%= turbo_frame_tag "profile-photo" do %>
        <div class="inline-flex items-end gap-3">
          <%= render FlatPack::Avatar::Component.new(
                src: attachment_preview_url(@profile_recording, variant: :square_med),
                size: :"2xl",
                shape: :circle
              ) %>
          <%= render_attachment_file_button(@profile_recording, return_to: edit_profile_path) %>
        </div>
      <% end %>
    </div>

    <%= form_with url: profile_path, method: :patch do %>
      <% if @profile.errors.any? %>
        <%= render FlatPack::Alert::Component.new(
          title: t("recording_studio_user.profile.errors.prevented_save", count: @profile.errors.count),
          description: @profile.errors.full_messages.join(", "),
          style: :danger
        ) %>
      <% end %>

      <div class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(
          name: "user[first_name]",
          id: "user_first_name",
          label: t("recording_studio_user.profile.first_name"),
          value: @profile.first_name,
          required: true,
          autocomplete: "given-name",
          error: @profile.errors[:first_name].first
        ) %>

        <%= render FlatPack::TextInput::Component.new(
          name: "user[last_name]",
          id: "user_last_name",
          label: t("recording_studio_user.profile.last_name"),
          value: @profile.last_name,
          required: true,
          autocomplete: "family-name",
          error: @profile.errors[:last_name].first
        ) %>

        <%= render FlatPack::Select::Component.new(
          name: "user[time_zone]",
          id: "user_time_zone",
          label: t("recording_studio_user.profile.time_zone"),
          value: @profile.time_zone,
          options: ActiveSupport::TimeZone.all.map { |zone| [zone.to_s, zone.name] },
          searchable: true,
          required: true,
          error: @profile.errors[:time_zone].first
        ) %>

        <% if profile_locale_allowlisted? %>
          <%= render FlatPack::Select::Component.new(
            name: "user[locale]",
            id: "user_locale",
            label: t("recording_studio_user.profile.language"),
            value: @profile.locale.to_s,
            options: profile_language_options(@profile),
            placeholder: false,
            searchable: false,
            error: @profile.errors[:locale].first
          ) %>
        <% end %>

        <% (RecordingStudioUser.config.additional_profile_attributes - [:locale]).each do |attribute| %>
          <%= render FlatPack::TextInput::Component.new(
            name: "user[#{attribute}]",
            id: "user_#{attribute}",
            label: t("recording_studio_user.profile.attributes.#{attribute}", default: attribute.to_s.humanize),
            value: @profile.additional_profile_attributes[attribute.to_s],
            error: @profile.errors[attribute].first
          ) %>
        <% end %>

        <div class="flex flex-wrap items-center gap-3">
          <%= render FlatPack::Button::Component.new(text: t("recording_studio_user.profile.update"), type: "submit", style: :primary) %>
          <%= render FlatPack::Button::Component.new(text: t("recording_studio_user.profile.cancel"), href: profile_path, style: :secondary) %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
