<% content_for :title, "Edit Profile | Recording Studio User" %>

<% recording_studio_page_nav(
  title: "Edit Profile",
  page_nav_back_url: profile_path,
  page_nav_back_label: "My Profile",
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: "Close"
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Edit Profile",
  subtitle: profile_display_name(@user),
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <div>
    <div class="mb-8">
      <%= turbo_frame_tag "profile-photo" do %>
        <div class="inline-flex items-end gap-3">
          <%= render FlatPack::Avatar::Component.new(
                src: attachment_preview_url(@profile_recording, variant: :square_med),
                size: :"2xl",
                shape: :circle
              ) %>
          <%= render_attachment_file_button(@profile_recording, return_to: edit_profile_path) %>
        </div>
      <% end %>
    </div>

    <%= form_with url: profile_path, method: :patch do %>
      <% if @profile.errors.any? %>
        <%= render FlatPack::Alert::Component.new(
          title: "#{pluralize(@profile.errors.count, "error")} prevented your profile from being saved",
          description: @profile.errors.full_messages.join(", "),
          style: :danger
        ) %>
      <% end %>

      <div class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(
          name: "user[first_name]",
          id: "user_first_name",
          label: "First name",
          value: @profile.first_name,
          required: true,
          autocomplete: "given-name",
          error: @profile.errors[:first_name].first
        ) %>

        <%= render FlatPack::TextInput::Component.new(
          name: "user[last_name]",
          id: "user_last_name",
          label: "Last name",
          value: @profile.last_name,
          required: true,
          autocomplete: "family-name",
          error: @profile.errors[:last_name].first
        ) %>

        <%= render FlatPack::Select::Component.new(
          name: "user[time_zone]",
          id: "user_time_zone",
          label: "Time zone",
          value: @profile.time_zone,
          options: ActiveSupport::TimeZone.all.map { |zone| [zone.to_s, zone.name] },
          searchable: true,
          required: true,
          error: @profile.errors[:time_zone].first
        ) %>

        <% RecordingStudioUser.config.additional_profile_attributes.each do |attribute| %>
          <%= render FlatPack::TextInput::Component.new(
            name: "user[#{attribute}]",
            id: "user_#{attribute}",
            label: attribute.to_s.humanize,
            value: @profile.additional_profile_attributes[attribute.to_s],
            error: @profile.errors[attribute].first
          ) %>
        <% end %>

        <div class="flex flex-wrap items-center gap-3">
          <%= render FlatPack::Button::Component.new(text: "Update profile", type: "submit", style: :primary) %>
          <%= render FlatPack::Button::Component.new(text: "Cancel", href: profile_path, style: :secondary) %>
        </div>
      </div>
    <% end %>

    <% if RecordingStudioUser.config.omniauth_configured? %>
      <div class="mt-10 space-y-4">
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Sign-in methods",
          subtitle: "Link a provider so you can sign in without typing a password."
        ) %>

        <% if @user.identities.any? %>
          <ul class="space-y-3">
            <% @user.identities.order(:provider).each do |identity| %>
              <li class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p class="font-medium"><%= recording_studio_user_provider_label(identity.provider) %></p>
                  <% if identity.email.present? %>
                    <p class="text-sm text-[var(--surface-muted-content-color)]"><%= identity.email %></p>
                  <% end %>
                </div>
                <%= render FlatPack::Button::Component.new(
                  text: "Disconnect",
                  href: profile_identity_path(identity.provider),
                  method: :delete,
                  style: :secondary,
                  size: :sm,
                  data: { turbo_confirm: "Disconnect #{recording_studio_user_provider_label(identity.provider)}?" }
                ) %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <% if recording_studio_user_google_oauth_configured? && !recording_studio_user_google_connected?(@user) %>
          <%= render FlatPack::Button::Component.new(
            text: "Connect Google",
            href: recording_studio_user_continue_with_google_path,
            method: :post,
            style: :secondary,
            size: :md,
            data: { turbo: false }
          ) %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
