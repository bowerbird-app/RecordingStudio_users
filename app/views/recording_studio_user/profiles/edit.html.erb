<% content_for :title, "Edit Profile | Recording Studio User" %>

<% recording_studio_page_nav(
  title: "Edit Profile",
  page_nav_back_url: profile_path,
  page_nav_back_label: "My Profile",
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: "Close"
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Edit Profile",
  subtitle: "Change your name, time zone, or photo.",
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <div>
    <div class="mb-8">
      <%= render_parent_attachment(@profile_recording, return_to: edit_profile_path, shape: :circle, size: :"2xl") %>
    </div>

    <%= form_with url: profile_path, method: :patch do %>
      <% if @profile.errors.any? %>
        <%= render FlatPack::Alert::Component.new(
          title: "#{pluralize(@profile.errors.count, "error")} prevented your profile from being saved",
          description: @profile.errors.full_messages.join(", "),
          style: :danger
        ) %>
      <% end %>

      <div class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(
          name: "user[first_name]",
          id: "user_first_name",
          label: "First name",
          value: @profile.first_name,
          required: true,
          autocomplete: "given-name",
          error: @profile.errors[:first_name].first
        ) %>

        <%= render FlatPack::TextInput::Component.new(
          name: "user[last_name]",
          id: "user_last_name",
          label: "Last name",
          value: @profile.last_name,
          required: true,
          autocomplete: "family-name",
          error: @profile.errors[:last_name].first
        ) %>

        <%= render FlatPack::Select::Component.new(
          name: "user[time_zone]",
          id: "user_time_zone",
          label: "Time zone",
          value: @profile.time_zone,
          options: ActiveSupport::TimeZone.all.map { |zone| [zone.to_s, zone.name] },
          searchable: true,
          required: true,
          error: @profile.errors[:time_zone].first
        ) %>

        <% RecordingStudioUser.config.additional_profile_attributes.each do |attribute| %>
          <%= render FlatPack::TextInput::Component.new(
            name: "user[#{attribute}]",
            id: "user_#{attribute}",
            label: attribute.to_s.humanize,
            value: @profile.additional_profile_attributes[attribute.to_s],
            error: @profile.errors[attribute].first
          ) %>
        <% end %>

        <div class="flex flex-wrap items-center gap-3">
          <%= render FlatPack::Button::Component.new(text: "Update profile", type: "submit", style: :primary) %>
          <%= render FlatPack::Button::Component.new(text: "Cancel", href: profile_path, style: :secondary) %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
