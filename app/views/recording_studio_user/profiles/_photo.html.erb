<% image_recording = profile_image_recording(@profile_recording) %>
<% preview_path = profile_image_preview_path(image_recording) %>
<% return_to = local_assigns.fetch(:return_to, profile_path) %>
<% photo_label = image_recording.present? ? "Swap this photo" : "Add a photo" %>

<%= form_with url: photo_profile_path, method: :patch, multipart: true, html: { class: "flex flex-wrap items-center gap-4" } do %>
  <%= hidden_field_tag :return_to, return_to %>

  <% if preview_path.present? %>
    <%= render FlatPack::Avatar::Component.new(
      src: preview_path,
      alt: profile_display_name(@user),
      name: profile_display_name(@user),
      size: :xl,
      shape: :circle
    ) %>
  <% else %>
    <%= render FlatPack::Avatar::Component.new(
      size: :xl,
      shape: :circle
    ) %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <%= file_field_tag :photo,
                       id: "profile_photo",
                       accept: "image/*",
                       required: true,
                       class: "text-sm text-[var(--surface-content-color)]" %>
    <%= render FlatPack::Button::Component.new(
      text: photo_label,
      style: :secondary,
      type: "submit"
    ) %>
  </div>
<% end %>
