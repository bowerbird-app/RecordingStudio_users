<% content_for :title, t("recording_studio_user.profile.my_profile") %>

<% flat_pack_page_nav(
  round: true,
  style: :default,
  anchor_href: main_app.root_path,
  anchor_tooltip: t("recording_studio_user.profile.close")
) %>

<% register_page_nav t("recording_studio_user.profile.edit"), edit_profile_path, role: :primary %>
<% if RecordingStudioUser.config.omniauth_configured? %>
  <% register_page_nav(
    t("recording_studio_user.profile.sign_in_methods"),
    sign_in_methods_profile_path,
    role: :secondary
  ) %>
<% end %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <%= render FlatPack::Card::Component.new(shadow: :md) do %>
    <%= render "avatar" %>
    <%= render FlatPack::SectionTitle::Component.new(
      title: profile_display_name(@user),
      subtitle: [
        @user.email,
        @profile.time_zone,
        profile_language_name(@profile)
      ].compact_blank.join(" · ")
    ) %>
  <% end %>
<% end %>
