<% content_for :title, rsu_t("profile.document_title", default: "%{page} | Recording Studio User", page: rsu_t("profile.my_profile", default: "My Profile")
) %>

<% recording_studio_page_nav(
  title: rsu_t("profile.my_profile", default: "My Profile"),
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: rsu_t("profile.close", default: "Close")
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: rsu_t("profile.my_profile", default: "My Profile"),
  variant: :h1
) do |page_title| %>
  <% page_title.slot do %>
    <%= render FlatPack::Button::Component.new(
      text: rsu_t("profile.edit", default: "Edit"),
      href: edit_profile_path,
      style: :primary
    ) %>
    <% if RecordingStudioUser.config.omniauth_configured? %>
      <%= render FlatPack::Button::Component.new(
        text: rsu_t("profile.sign_in_methods", default: "Sign-in methods"),
        href: sign_in_methods_profile_path,
        style: :secondary
      ) %>
    <% end %>
  <% end %>
<% end %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <%= render FlatPack::Card::Component.new(style: :elevated) do %>
    <%= render "avatar" %>
    <div>
      <p class="font-semibold"><%= profile_display_name(@user) %></p>
      <p class="text-[var(--surface-muted-content-color)]"><%= @user.email %></p>
      <p class="text-[var(--surface-muted-content-color)]"><%= @profile.time_zone %></p>
      <% if (language = profile_language_name(@profile)).present? %>
        <p class="text-[var(--surface-muted-content-color)]"><%= language %></p>
      <% end %>
    </div>
  <% end %>
<% end %>
