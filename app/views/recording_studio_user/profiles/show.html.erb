<div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "My profile",
    subtitle: "Your site-level identity and preferences"
  ) %>

  <% if notice.present? %>
    <%= render FlatPack::Alert::Component.new(
      title: "Profile updated",
      description: notice,
      style: :success
    ) %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <%= render FlatPack::Table::Component.new(
        data: [
          { field: "Name", value: @user.display_name },
          { field: "Email", value: @user.email },
          { field: "Time zone", value: @user.time_zone }
        ]
      ) do |table| %>
        <% table.column(title: "Profile field") { |row| row[:field] } %>
        <% table.column(title: "Value") { |row| row[:value] } %>
      <% end %>
    <% end %>

    <% card.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "Edit profile",
        url: main_app.edit_profile_path,
        style: :primary,
        icon: :pencil
      ) %>
    <% end %>
  <% end %>
</div>
