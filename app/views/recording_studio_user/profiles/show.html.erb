<% content_for :title, t(
  "recording_studio_user.profile.document_title",
  page: t("recording_studio_user.profile.my_profile")
) %>

<% recording_studio_page_nav(
  title: t("recording_studio_user.profile.my_profile"),
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: t("recording_studio_user.profile.close")
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: t("recording_studio_user.profile.my_profile"),
  variant: :h1
) do |page_title| %>
  <% page_title.slot do %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio_user.profile.edit"),
      href: edit_profile_path,
      style: :primary
    ) %>
    <% if RecordingStudioUser.config.omniauth_configured? %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio_user.profile.sign_in_methods"),
        href: sign_in_methods_profile_path,
        style: :secondary
      ) %>
    <% end %>
  <% end %>
<% end %>

<%= render FlatPack::Grid::Component.new(cols: 2) do %>
  <%= render FlatPack::Card::Component.new(style: :elevated) do %>
    <%= render "avatar" %>
    <div>
      <p class="font-semibold"><%= profile_display_name(@user) %></p>
      <p class="text-[var(--surface-muted-content-color)]"><%= @user.email %></p>
      <p class="text-[var(--surface-muted-content-color)]"><%= @profile.time_zone %></p>
      <% if (language = profile_language_name(@profile)).present? %>
        <p class="text-[var(--surface-muted-content-color)]"><%= language %></p>
      <% end %>
    </div>
  <% end %>
<% end %>
