<% content_for :title, "My Profile | Recording Studio User" %>

<%= render FlatPack::PageNav::Component.new(
  anchor_url: main_app.root_path,
  anchor_icon: "home",
  anchor_tooltip: "Home"
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "My Profile",
  subtitle: "Manage your personal details and account settings.",
  variant: :h1
) %>

<% if notice.present? %>
  <%= render FlatPack::Alert::Component.new(description: notice, style: :success, dismissible: true) %>
<% end %>

<div class="mt-6 space-y-4">
  <%= render FlatPack::Button::Component.new(
    text: "Edit",
    url: edit_profile_path,
    style: :secondary
  ) %>

  <dl class="space-y-4">
    <div>
      <dt class="text-sm text-[var(--surface-muted-content-color)]">Name</dt>
      <dd class="mt-1 font-medium"><%= profile_display_name(@user) %></dd>
    </div>
    <div>
      <dt class="text-sm text-[var(--surface-muted-content-color)]">Email</dt>
      <dd class="mt-1 font-medium"><%= @user.email %></dd>
    </div>
    <div>
      <dt class="text-sm text-[var(--surface-muted-content-color)]">Time zone</dt>
      <dd class="mt-1 font-medium"><%= @user.time_zone %></dd>
    </div>
  </dl>
</div>
