<div class="fixed inset-0 p-4">
  <%= render FlatPack::Grid::Component.new(cols: 1, align: :center, class: "h-full w-full place-content-center justify-items-center") do %>
    <%= render FlatPack::Card::Component.new(style: :default, class: "w-full max-w-md h-auto") do |card| %>
      <% card.body do %>
        <div class="space-y-6">
          <%= render FlatPack::PageTitle::Component.new(
            title: "Create your account",
            subtitle: "Then name your workspace. You will be its first admin.",
            variant: :h2,
            class: "mb-0 pb-0"
          ) %>

          <% if resource.errors.any? %>
            <%= render FlatPack::Alert::Component.new(
              title: "That did not work",
              description: resource.errors.full_messages.to_sentence,
              style: :warning
            ) %>
          <% end %>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <div class="space-y-4">
              <%= render FlatPack::EmailInput::Component.new(
                name: "user[email]",
                label: "Email",
                value: resource.email,
                placeholder: "you@example.com",
                required: true
              ) %>

              <%= render FlatPack::PasswordInput::Component.new(
                name: "user[password]",
                label: "Password",
                required: true
              ) %>

              <%= render FlatPack::PasswordInput::Component.new(
                name: "user[password_confirmation]",
                label: "Password again",
                required: true
              ) %>

              <%= render FlatPack::Button::Component.new(
                text: "Create account",
                style: :primary,
                size: :md,
                type: "submit"
              ) %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% card.footer do %>
        <%= render FlatPack::Link::Component.new(href: new_session_path(resource_name)) do %>
          Already have an account? Sign in
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
