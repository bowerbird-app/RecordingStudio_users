<div class="flex min-h-dvh items-center justify-center">
  <div class="w-full max-w-sm space-y-6">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Sign up",
      variant: :h2,
      class: "mb-0 pb-0 text-center"
    ) %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="space-y-4">
        <% if resource.errors.any? %>
          <%= render FlatPack::Alert::Component.new(
            title: "That sign up did not save",
            description: resource.errors.full_messages.join(", "),
            style: :danger
          ) %>
        <% end %>

        <%= render FlatPack::EmailInput::Component.new(
          name: "user[email]",
          id: "user_email",
          label: "Email",
          value: resource.email,
          placeholder: "you@example.com",
          required: true,
          autocomplete: "email",
          error: resource.errors[:email].first
        ) %>

        <%= render FlatPack::PasswordInput::Component.new(
          name: "user[password]",
          id: "user_password",
          label: "Password",
          required: true,
          autocomplete: "new-password",
          help_text: "#{Devise.password_length.min} characters minimum",
          error: resource.errors[:password].first
        ) %>

        <% if RecordingStudioUser.config.require_password_confirmation? %>
          <%= render FlatPack::PasswordInput::Component.new(
            name: "user[password_confirmation]",
            id: "user_password_confirmation",
            label: "Password confirmation",
            required: true,
            autocomplete: "new-password",
            error: resource.errors[:password_confirmation].first
          ) %>
        <% end %>

        <%= render FlatPack::Button::Component.new(
          text: "Sign up",
          style: :primary,
          size: :md,
          type: "submit",
          class: "w-full"
        ) %>
      </div>
    <% end %>

    <p class="text-center text-sm text-[var(--surface-muted-content-color)]">
      Already have one?
      <%= render FlatPack::Link::Component.new(href: new_session_path(resource_name)) do %>
        Log in
      <% end %>
    </p>

    <%= render "recording_studio_user/omniauth/continue_with_providers" %>
  </div>
</div>
