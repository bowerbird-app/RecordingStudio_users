<%= render FlatPack::Grid::Component.new(cols: 1, justify: :center, max: :sm) do %>
  <div class="space-y-6">
    <%= render FlatPack::PageTitle::Component.new(
      title: RecordingStudioUser.config.login_title,
      variant: :h2,
      class: "mb-0 pb-0"
    ) %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-4">
        <%= render FlatPack::EmailInput::Component.new(
          name: "user[email]",
          label: "Email",
          value: "admin@admin.com",
          placeholder: "you@example.com"
        ) %>

        <%= render FlatPack::PasswordInput::Component.new(
          name: "user[password]",
          label: "Password",
          value: "Password",
          required: true
        ) %>

        <%= render FlatPack::Button::Component.new(
          text: "Sign in",
          style: :primary,
          size: :md,
          type: "submit",
          class: "w-full"
        ) %>
      </div>
    <% end %>

    <p class="text-sm text-[var(--surface-muted-content-color)]">
      Don't have an account?
      <%= render FlatPack::Link::Component.new(href: new_registration_path(resource_name)) do %>
        Sign up
      <% end %>
    </p>

    <%= render "recording_studio_user/omniauth/continue_with_providers" %>
  </div>

  <%= render FlatPack::Badge::Component.new(
    text: "Default: admin@admin.com / Password",
    style: :info,
    size: :sm
  ) %>
<% end %>
