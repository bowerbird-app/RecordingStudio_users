<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Your workspace",
    subtitle: "Identity finds you. Accessible decides what you can do.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: current_root_recordable&.name || "Workspace",
          subtitle: "This is the root selected for this device.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-content-color)">
          Invite people, change their roles, or try a lower working role without changing your real access.
        </p>
      <% end %>

      <% card.footer do %>
        <%= link_to recording_studio_users.invitations_path(root_recording_id: current_root_recording.id) do %>
          <%= render FlatPack::Button::Component.new(
            text: "Manage people",
            style: :primary,
            size: :md
          ) %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Three clear jobs",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Devise identifies the signed-in person.</li>
          <li>Accessible sets the real access ceiling.</li>
          <li>Root Switchable remembers the workspace in use.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
