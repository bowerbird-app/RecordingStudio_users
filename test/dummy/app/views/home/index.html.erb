<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio Users",
    subtitle: "Manage membership for the workspace selected in the top navigation.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <div class="space-y-4">
        <p>Access is stored by Recording Studio Accessible. Devise users remain owned by this host app.</p>
        <%= render FlatPack::Button::Component.new(
          text: "Manage workspace members",
          style: :primary,
          url: recording_studio_users.root_path
        ) %>
      </div>
    <% end %>
  <% end %>
</div>
