<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "RecordingStudioUser demo",
    subtitle: "Global profiles with separate workspace and access-controlled admin roots"
  ) %>

  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg) do %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "My workspace",
          subtitle: "A normal user-facing Recording Studio root"
        ) %>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::Alert::Component.new(
          title: "Profile data stays global",
          description: "Names, email addresses, and time zones do not belong to this root.",
          style: :info
        ) %>
      <% end %>
      <% card.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "My profile",
          url: profile_path,
          style: :primary,
          icon: :user
        ) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Admin",
          subtitle: "A distinct root protected by RecordingStudioAccessible"
        ) %>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::Alert::Component.new(
          title: "Access is root-based",
          description: "Administrative access comes from a Recording Studio access grant, never a User flag.",
          style: :info
        ) %>
      <% end %>
      <% card.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "Open admin",
          url: recording_studio_admin_admin.root_path,
          style: :primary,
          icon: :settings
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
