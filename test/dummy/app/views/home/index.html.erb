<div class="flex flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: current_root_recordable&.name || "Workspace",
    variant: :h1
  ) %>

  <div id="home-actions" class="flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "My Profile",
      url: recording_studio_users.profile_path,
      style: :secondary
    ) %>

    <% if current_root_recordable.is_a?(AdminRoot) %>
      <%= render FlatPack::Button::Component.new(
        text: "Users Admin",
        url: recording_studio_users.admin_path,
        style: :secondary
      ) %>
    <% end %>
  </div>
</div>