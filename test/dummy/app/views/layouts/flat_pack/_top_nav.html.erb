<%= render FlatPack::TopNav::Component.new do |nav| %>
  <% nav.left do %>
    <%= render FlatPack::Button::Component.new(
      icon: "menu",
      icon_only: true,
      style: :ghost,
      size: :md,
      aria: {label: "Toggle sidebar"},
      data: {
        "flat-pack--sidebar-layout-target": "mobileToggle",
        action: "click->flat-pack--sidebar-layout#toggleMobile"
      },
      class: "md:hidden"
    ) %>

  <% end %>

  <% nav.center do %>
    <span aria-hidden="true"></span>
  <% end %>

  <% nav.right do %>
    <% if user_signed_in? %>
      <div class="flex items-center gap-3">
        <% if RecordingStudioAccessible.root_recordings_for(actor: current_user).any? %>
          <%= recording_studio_root_switch_dropdown(style: :ghost, size: :md) %>
        <% else %>
          <%= link_to recording_studio_users.onboarding_path do %>
            <%= render FlatPack::Button::Component.new(
              text: "Set up workspace",
              style: :primary,
              size: :sm
            ) %>
          <% end %>
        <% end %>

        <%= render FlatPack::Avatar::Component.new(
          name: current_user.try(:name).presence || current_user.email,
          size: :sm
        ) %>
      </div>
    <% end %>
  <% end %>
<% end %>