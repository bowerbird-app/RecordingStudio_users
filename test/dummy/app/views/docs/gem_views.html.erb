<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Gem Views",
    subtitle: "Diagnostic list of view templates currently shipped by RecordingStudioUser.",
    variant: :h1
  ) %>

  <p class="text-sm leading-6 text-(--surface-content-color)">
    This diagnostic lists engine templates. People is the shared root for Profile snapshots; User stays a Devise actor outside the tree.
  </p>

  <% view_rows = Array(@engine_views).map { |view_path| { path: view_path, source: "Gem engine" } } %>

  <%= render FlatPack::Table::Component.new(data: view_rows, class: "text-sm") do |table| %>
    <% table.column(title: "View path") { |view| view[:path] } %>
    <% table.column(title: "Source") { |view| view[:source] } %>
  <% end %>
</div>
