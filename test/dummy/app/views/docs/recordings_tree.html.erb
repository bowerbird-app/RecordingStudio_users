<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recordings tree",
    subtitle: "Diagnostic view of dummy-app recordings as a nested parent/child outline.",
    variant: :h1
  ) %>

  <p class="text-sm leading-6 text-(--surface-content-color)">
    This unfiltered diagnostic includes recordings regardless of trash state. People is the shared root
    for Profile snapshots; User stays a Devise actor outside the tree.
  </p>

  <% if @recording_tree.any? %>
    <%= render FlatPack::Tree::Component.new(compact: true) do |tree| %>
      <% @recording_tree.each do |node| %>
        <%= render partial: "recording_tree_node", locals: { parent_builder: tree, node: node } %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">No recordings found.</p>
  <% end %>
</div>
